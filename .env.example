# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP (アプリパスワード。通常のログインパスワードは不可)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 省略時は GMAIL_USER 宛に送る。カンマ区切りで複数可
MAIL_TO=

# 通知する最低割引額（円）。0 なら全件通知
MIN_DISCOUNT_YEN=0

# 配布終了（売り切れ）への遷移も通知するか
NOTIFY_ON_SOLD_OUT=false

# メールを送らず標準出力に出すだけ（動作確認用）
DRY_RUN=false

# 地域ごとのリクエスト間ディレイ（秒）
REQUEST_DELAY_SEC=1.5
